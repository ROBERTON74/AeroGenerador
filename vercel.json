{
  "buildCommand": "npm run build:all",
  "installCommand": "npm ci --include=dev && npm ci --prefix portal --include=dev",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/portal",
      "destination": "/portal/index.html"
    },
    {
      "source": "/esios-api/:path*",
      "destination": "/api/esios?path=:path*"
    },
    {
      "source": "/ree-api/:path*",
      "destination": "/api/ree?path=:path*"
    },
    {
      "source": "/open-meteo-api/:path*",
      "destination": "/api/open-meteo?path=:path*"
    }
  ]
}
